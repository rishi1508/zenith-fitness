<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <external-path name="my_images" path="." />
    <cache-path name="my_cache_images" path="." />
    <!-- @capacitor/camera writes the capture into the app's own external
         files dir (and, on some flows, internal files); both are shared with
         the camera app through this provider. -->
