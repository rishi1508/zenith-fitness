rules_version = '2';

// Zenith Fitness — Firestore security rules.
//
// Collections:
//   userProfiles/{uid}           — public profile (search), owner-writable
//   users/{uid}/data/{doc}       — private per-user data (workouts, settings, …)
//   buddies/{pairId}             — mutual friendship (sorted uid1_uid2)
//   buddyRequests/{requestId}    — pending friendship requests
//   chats/{chatId}               — chat doc; messages nested
//   notifications/{uid}/items/…  — in-app notifications
//   workoutSessions/{id}         — group workout sessions + subcollections
//   sharedExercises/{id}         — shared exercise library, one doc per exercise
//   shared/{document}            — LEGACY single-doc exercise library (read-only)
//   gymJoinCodes/{code}          — join-code → gymId lookup (Gym OS lite, Tier A)
//   gyms/{gymId}                 — gym + members/payments/checkins/classes/announcements
//
// The read rule on userProfiles intentionally allows any signed-in user to
// read any profile so search + buddy comparison work across accounts.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Accounts allowed to edit any shared exercise. Mirrors src/admin.ts.
    function isAdmin() {
      return signedIn() && request.auth.uid in [
        'BXedteurc3bPydsehvPIdVWPTbM2',
        'upLvcTSoE5SS7lOmhYBKHFWSV0r1' // QA admin (demo) — remove after launch
      ];
    }

    // ---------- Gym OS lite (Tier A) helpers ----------
    // See docs/GYM_TIER_A_SPEC.md §4. Rules trust the gym doc's `staff`
    // map / `ownerUid`, not the mirrored `gymRole` on userProfiles.
    function gymDoc(gymId) { return get(/databases/$(database)/documents/gyms/$(gymId)).data; }
    function isGymStaff(gymId) { return signedIn() && request.auth.uid in gymDoc(gymId).staff; }
    function gymStaffRole(gymId) { return gymDoc(gymId).staff[request.auth.uid]; }
    function isGymManager(gymId) { return isGymStaff(gymId) && gymStaffRole(gymId) in ['manager', 'owner']; }
    // A gym has one ownerUid but may grant `staff[uid] = 'owner'` to others
    // (the client treats that role as owner too) — accept either.
    function isGymOwner(gymId) { return signedIn() && (request.auth.uid == gymDoc(gymId).ownerUid || (isGymStaff(gymId) && gymStaffRole(gymId) == 'owner')); }
    function isGymMember(gymId) { return signedIn() && exists(/databases/$(database)/documents/gyms/$(gymId)/members/$(request.auth.uid)); }

    // ---------- userProfiles ----------
    // Publicly readable by authenticated users (for search + comparison).
    // Only the owner can write their own profile.
    match /userProfiles/{uid} {
      allow read:   if signedIn();
      allow create: if signedIn() && request.auth.uid == uid;
      // The owner can write anything on their own profile. A manager of
      // the member's gym may ALSO set just the `gym` pointer — used when
      // staff adds/links a member by email (addMember in gymService.ts).
      allow update: if signedIn() && (
        request.auth.uid == uid ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['gym']) && isGymManager(request.resource.data.gym.gymId)) ||
        isAdmin()
      );
      allow delete: if false;

      // FCM push-notification tokens. Only the owner can see / manage
      // their own device tokens. The Vercel push function reads these
      // via the firebase-admin SDK which bypasses rules, so we don't
      // need to open this to other users.
      match /fcmTokens/{tokenId} {
        allow read, write, delete: if signedIn() && request.auth.uid == uid;
      }
    }

    // ---------- per-user private data ----------
    // Workouts, exercises, templates, records — only the owner can read/write.
    match /users/{uid}/{doc=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // ---------- buddy requests ----------
    match /buddyRequests/{requestId} {
      allow read:   if signedIn() && (
        request.auth.uid == resource.data.fromUid ||
        request.auth.uid == resource.data.toUid
      );
      allow create: if signedIn() && request.auth.uid == request.resource.data.fromUid;
      allow update: if signedIn() && (
        request.auth.uid == resource.data.fromUid ||
        request.auth.uid == resource.data.toUid
      );
      allow delete: if signedIn() && (
        request.auth.uid == resource.data.fromUid ||
        request.auth.uid == resource.data.toUid
      );
    }

    // ---------- buddy relationships ----------
    // pairId is a deterministic "sorted_uid1_uid2". `users` is a 2-element array.
    // We split `get` (single-doc probe) from `list` (query) so that the
    // "are we already buddies?" probe against a NON-existent pair doesn't
    // crash on `resource.data.users` (resource is null for missing docs).
    // Instead we authorise the probe by reading the caller's uid out of
    // the deterministic pairId — only the two buddies can construct it
    // anyway, so no new information leaks.
    match /buddies/{pairId} {
      allow get:    if signedIn() &&
        pairId.split('_').hasAny([request.auth.uid]);
      allow list:   if signedIn() && request.auth.uid in resource.data.users;
      allow create: if signedIn() && request.auth.uid in request.resource.data.users;
      allow update: if signedIn() && request.auth.uid in resource.data.users;
      allow delete: if signedIn() && request.auth.uid in resource.data.users;
    }

    // ---------- chats + messages ----------
    match /chats/{chatId} {
      allow read:   if signedIn() && request.auth.uid in resource.data.users;
      allow create: if signedIn() && request.auth.uid in request.resource.data.users;
      allow update: if signedIn() && request.auth.uid in resource.data.users;

      match /messages/{messageId} {
        allow read:   if signedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users;
        allow create: if signedIn() && request.auth.uid == request.resource.data.senderId;
        // Allow ONLY the `reactions` field to change, and only by a chat
        // participant. The old rule was a blanket `if false` which
        // silently dropped every reaction toggle — local state flipped,
        // the listener then overwrote it with server state, and the
        // reaction vanished.
        allow update: if signedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']);
        allow delete: if signedIn() && request.auth.uid == resource.data.senderId;
      }
    }

    // ---------- notifications ----------
    // Only the recipient can read. Any signed-in user can create (senders
    // include buddy requests, chat notifications, session invites, etc.).
    match /notifications/{uid}/items/{notifId} {
      allow read:   if signedIn() && request.auth.uid == uid;
      // The sender must be who they say they are; keeps the in-app toast
      // and the push title honest and stops third parties spamming a user.
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.message is string && request.resource.data.message.size() <= 500;
      allow update: if signedIn() && request.auth.uid == uid;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // ---------- workoutSessions ----------
    // `participants` is a map keyed by uid. `in` on a map checks key membership.
    match /workoutSessions/{sessionId} {
      allow read:   if signedIn() && (
        request.auth.uid == resource.data.hostUid ||
        request.auth.uid in resource.data.participants
      );
      allow create: if signedIn() && request.auth.uid == request.resource.data.hostUid;
      allow update: if signedIn() && (
        request.auth.uid == resource.data.hostUid ||
        request.auth.uid in resource.data.participants
      );
      allow delete: if signedIn() && request.auth.uid == resource.data.hostUid;

      // Per-participant live progress snapshot. Only session participants
      // (host included) can read — previously any signed-in user could
      // spy on another session's live workout data.
      match /progress/{uid} {
        allow read:   if signedIn() && (
          request.auth.uid == uid ||
          request.auth.uid in get(/databases/$(database)/documents/workoutSessions/$(sessionId)).data.participants
        );
        allow write:  if signedIn() && request.auth.uid == uid;
      }

      // Ephemeral reaction stream — participants only.
      match /reactions/{reactionId} {
        allow read:   if signedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/workoutSessions/$(sessionId)).data.participants;
        allow create: if signedIn() &&
          request.auth.uid == request.resource.data.fromUid &&
          request.auth.uid in get(/databases/$(database)/documents/workoutSessions/$(sessionId)).data.participants;
      }
    }

    // ---------- shared exercise library (one doc per exercise) ----------
    // Anyone signed in can read and can create exercises they own. Only
    // the creator or an admin can change or remove a definition — this
    // is what makes "creator notes visible to everyone" trustworthy.
    match /sharedExercises/{exerciseId} {
      allow read:   if signedIn();
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if signedIn() && (resource.data.createdBy == request.auth.uid || isAdmin());
      allow delete: if signedIn() && (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    // ---------- shared food library (docs/HEALTH_SPEC.md) ----------
    // Same creator model as sharedExercises: anyone signed in can read,
    // creators own their docs, admins can moderate.
    match /sharedFoods/{foodId} {
      allow read:   if signedIn();
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if signedIn() && (resource.data.createdBy == request.auth.uid || isAdmin());
      allow delete: if signedIn() && (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    // ---------- shared meals (a set of foods logged together) ----------
    // Same creator model as sharedFoods.
    match /sharedMeals/{mealId} {
      allow read:   if signedIn();
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if signedIn() && (resource.data.createdBy == request.auth.uid || isAdmin());
      allow delete: if signedIn() && (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    // ---------- LEGACY shared exercise library ----------
    // The old single array document. Kept readable because older clients
    // still pull it and useOnlineStatus uses it as a connectivity probe;
    // no longer writable — any signed-in user could overwrite it wholesale.
    match /shared/{document} {
      allow read:   if signedIn();
    }

    // ---------- shared templates library ----------
    // Any authenticated user can browse + publish a template. The creator
    // may edit; anyone else may only bump useCount by exactly one.
    match /sharedTemplates/{templateId} {
      allow read:   if signedIn();
      allow create: if signedIn() && request.auth.uid == request.resource.data.creatorUid;
      allow update: if signedIn() && (
        request.auth.uid == resource.data.creatorUid ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['useCount'])
          && request.resource.data.useCount == resource.data.useCount + 1)
      );
      allow delete: if signedIn() && request.auth.uid == resource.data.creatorUid;
    }

    // ---------- Gym OS lite (Tier A) ----------
    // See docs/GYM_TIER_A_SPEC.md §3-4.
    // Join-code → gymId lookup. Created in the same batch as the gym (by its
    // owner); only that gym's owner or an admin can rotate/remove it.
    match /gymJoinCodes/{code} {
      allow get:    if signedIn();
      // Only the owner of the gym the code points at (getAfter: the gym may
      // be created in the same batch) or an admin may mint a code.
      allow create: if signedIn() && request.resource.data.gymId is string && (
        isAdmin() ||
        getAfter(/databases/$(database)/documents/gyms/$(request.resource.data.gymId)).data.ownerUid == request.auth.uid
      );
      allow update, delete: if isGymOwner(resource.data.gymId) || isAdmin();
    }

    match /gyms/{gymId} {
      allow read: if isGymMember(gymId) || isGymStaff(gymId) || isAdmin();
      allow create: if signedIn() && ((request.resource.data.ownerUid == request.auth.uid && request.resource.data.staff[request.auth.uid] == 'owner') || isAdmin());
      allow update: if isGymOwner(gymId) || isAdmin()
                    || (isGymStaff(gymId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dailyCodeHash', 'dailyCodeDate']))
                    || (isGymManager(gymId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount', 'plans']));
      allow delete: if false;

      match /members/{uid} {
        allow read: if isGymStaff(gymId) || isAdmin() || request.auth.uid == uid;
        // joining: a signed-in user creates their own member doc with role
        // 'member' — but only with a join code that really belongs to this
        // gym (the code is the invitation; without this check anyone who
        // knew a gym id could enrol themselves).
        allow create: if isGymManager(gymId) || isAdmin() || (
          signedIn() && request.auth.uid == uid && request.resource.data.role == 'member'
          && request.resource.data.joinCode is string
          && get(/databases/$(database)/documents/gymJoinCodes/$(request.resource.data.joinCode)).data.gymId == gymId
        );
        allow update: if isGymManager(gymId) || isAdmin()
                      || (isGymStaff(gymId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastCheckinAt', 'checkinCount30d']))
                      || (request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastCheckinAt', 'checkinCount30d', 'lastWorkoutAt', 'photoURL', 'phone']));
        allow delete: if isGymManager(gymId) || isAdmin();
      }
      match /payments/{id}   { allow read: if isGymStaff(gymId) || isAdmin() || request.auth.uid == resource.data.uid; allow create, update: if isGymManager(gymId) || isAdmin(); allow delete: if isGymOwner(gymId) || isAdmin(); }
      match /checkins/{id}   { allow read: if isGymStaff(gymId) || isAdmin() || request.auth.uid == resource.data.uid;
                               // Self check-in: the doc id must be `${uid}_${date}` and, for the
                               // daily code, the hash the client presents must match today's code
                               // on the gym doc (the code is otherwise only verified client-side).
                               allow create: if isGymStaff(gymId) || isAdmin() || (
                                 signedIn() && request.auth.uid == request.resource.data.uid
                                 && id == request.auth.uid + '_' + request.resource.data.date
                                 && (
                                   // 'member-qr' is self-reported: the client checks the gym's
                                   // geofence (src/geo.ts) and writes the distance, but rules
                                   // cannot verify a location. The daily code below is the
                                   // verified path — staff rotate it and rules check the hash.
                                   request.resource.data.method == 'member-qr' ||
                                   (request.resource.data.method == 'code'
                                     && request.resource.data.codeHash == gymDoc(gymId).dailyCodeHash
                                     && request.resource.data.date == gymDoc(gymId).dailyCodeDate)
                                 )
                               );
                               allow update, delete: if isGymManager(gymId) || isAdmin(); }
      match /dailyStats/{date} { allow read: if isGymStaff(gymId) || isAdmin();
                               // Members may only bump the counter by one (their own check-in).
                               allow create: if isGymStaff(gymId) || isAdmin() || (isGymMember(gymId)
                                 && request.resource.data.keys().hasOnly(['date', 'count', 'hours'])
                                 && request.resource.data.date == date && request.resource.data.count == 1);
                               allow update: if isGymStaff(gymId) || isAdmin() || (isGymMember(gymId)
                                 && request.resource.data.keys().hasOnly(['date', 'count', 'hours'])
                                 && request.resource.data.date == date && request.resource.data.count == resource.data.count + 1); }
      match /classes/{id}    { allow read: if isGymMember(gymId) || isGymStaff(gymId) || isAdmin(); allow write: if isGymManager(gymId) || isAdmin();
        match /sessions/{date} { allow read: if isGymMember(gymId) || isGymStaff(gymId) || isAdmin();
                                 // Staff/admin: anything. Member: may CREATE the session doc as the first
                                 // enrollee (only themselves enrolled, nobody attended) and may UPDATE only
                                 // the enrolled array (enrol / unenrol).
                                 allow create: if isGymStaff(gymId) || isAdmin()
                                   || (isGymMember(gymId) && request.resource.data.enrolled.hasOnly([request.auth.uid]) && request.resource.data.attended.size() == 0);
                                 allow update: if isGymStaff(gymId) || isAdmin()
                                   || (isGymMember(gymId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enrolled']));
                                 allow delete: if false; } }
      match /announcements/{id} { allow read: if isGymMember(gymId) || isGymStaff(gymId) || isAdmin(); allow create: if isGymStaff(gymId) || isAdmin(); allow update, delete: if isGymManager(gymId) || isAdmin(); }
    }
  }
}
