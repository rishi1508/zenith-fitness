rules_version = '2';

// Zenith Fitness — Firestore security rules.
//
// Collections:
//   userProfiles/{uid}           — public profile (search), owner-writable
//   users/{uid}/data/{doc}       — private per-user data (workouts, settings, …)
//   buddies/{pairId}             — mutual friendship (sorted uid1_uid2)
//   buddyRequests/{requestId}    — pending friendship requests
//   chats/{chatId}               — chat doc; messages nested
//   notifications/{uid}/items/…  — in-app notifications
//   workoutSessions/{id}         — group workout sessions + subcollections
//   sharedExercises/{id}         — shared exercise library, one doc per exercise
//   shared/{document}            — LEGACY single-doc exercise library (read-only)
//   gymJoinCodes/{code}          — join-code → gymId lookup (Gym OS lite, Tier A)
//   gyms/{gymId}                 — gym + members/payments/checkins/classes/announcements
//
// The read rule on userProfiles intentionally allows any signed-in user to
// read any profile so search + buddy comparison work across accounts.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Accounts allowed to edit any shared exercise. Mirrors src/admin.ts.
    function isAdmin() {
      return signedIn() && request.auth.uid in [
        'BXedteurc3bPydsehvPIdVWPTbM2',
        'upLvcTSoE5SS7lOmhYBKHFWSV0r1' // QA admin (demo) — remove after launch
      ];
    }

    // ---------- Gym OS lite (Tier A) helpers ----------
    // See docs/GYM_TIER_A_SPEC.md §4. Rules trust the gym doc's `staff`
    // map / `ownerUid`, not the mirrored `gymRole` on userProfiles.
    function gymDoc(gymId) { return get(/databases/$(database)/documents/gyms/$(gymId)).data; }
    function isGymStaff(gymId) { return signedIn() && request.auth.uid in gymDoc(gymId).staff; }
    function gymStaffRole(gymId) { return gymDoc(gymId).staff[request.auth.uid]; }
    function isGymManager(gymId) { return isGymStaff(gymId) && gymStaffRole(gymId) in ['manager', 'owner']; }
    // A gym has one ownerUid but may grant `staff[uid] = 'owner'` to others
    // (the client treats that role as owner too) — accept either.
    function isGymOwner(gymId) { return signedIn() && (request.auth.uid == gymDoc(gymId).ownerUid || (isGymStaff(gymId) && gymStaffRole(gymId) == 'owner')); }
    function isGymMember(gymId) { return signedIn() && exists(/databases/$(database)/documents/gyms/$(gymId)/members/$(request.auth.uid)); }
    // YYYY-MM-DD of a timestamp (UTC). A client's local date is always within
    // a day of it, which is the window self-reported check-in dates must fit.
    function pad2(n) { return n < 10 ? '0' + string(n) : string(n); }
    function dayStr(t) { return string(t.year()) + '-' + pad2(t.month()) + '-' + pad2(t.day()); }
    function nearToday(d) {
      return d in [dayStr(request.time - duration.value(1, 'd')), dayStr(request.time), dayStr(request.time + duration.value(1, 'd'))];
    }
    // The invite created against the caller's own e-mail, if any.
    function myInvite() { return get(/databases/$(database)/documents/gymInvites/$(request.auth.token.email.lower())).data; }

    // ---------- userProfiles ----------
    // Publicly readable by authenticated users (for search + comparison).
    // Only the owner can write their own profile.
    match /userProfiles/{uid} {
      allow read:   if signedIn();
      allow create: if signedIn() && request.auth.uid == uid;
      // The owner can write anything on their own profile. A manager of
      // the member's gym may ALSO set just the `gym` pointer — used when
      // staff adds/links a member by email (addMember in gymService.ts).
      allow update: if signedIn() && (
        request.auth.uid == uid ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['gym'])
          && isGymManager(request.resource.data.gym.gymId)
          // ...but never to pull somebody out of another gym.
          && (resource.data.get('gym', null) == null || resource.data.gym.gymId == request.resource.data.gym.gymId)) ||
        // Somebody following or unfollowing this person may move that one
        // counter by one, and nothing else (src/followService.ts) — and only
        // in step with their own edge: +1 once the edge exists, -1 once it is
        // gone. Without that a stranger could inflate anybody's follower count.
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followerCount'])
          && request.resource.data.followerCount is int
          && request.resource.data.followerCount >= 0
          && ((request.resource.data.followerCount == resource.data.get('followerCount', 0) + 1
                && exists(/databases/$(database)/documents/follows/$(request.auth.uid + '__' + uid)))
            || (request.resource.data.followerCount == resource.data.get('followerCount', 0) - 1
                && !exists(/databases/$(database)/documents/follows/$(request.auth.uid + '__' + uid))))) ||
        // The buddy follow-back bumps the buddy's `followingCount` by one.
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followingCount'])
          && request.resource.data.followingCount is int
          && request.resource.data.followingCount >= 0
          && areBuddies(request.auth.uid, uid)
          && (request.resource.data.followingCount == resource.data.get('followingCount', 0) + 1
            || request.resource.data.followingCount == resource.data.get('followingCount', 0) - 1)) ||
        isAdmin()
      );
      allow delete: if false;

      // FCM push-notification tokens. Only the owner can see / manage
      // their own device tokens. The Vercel push function reads these
      // via the firebase-admin SDK which bypasses rules, so we don't
      // need to open this to other users.
      match /fcmTokens/{tokenId} {
        allow read, write, delete: if signedIn() && request.auth.uid == uid;
      }
    }

    // ---------- per-user private data ----------
    // Workouts, exercises, templates, records — only the owner can read/write.
    match /users/{uid}/{doc=**} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // ---------- buddy requests ----------
    // One document per direction at `<from>__<to>` (3.26.0), so a request
    // notification can be checked against the request it announces. Either
    // party may move `status` and nothing else — the answer is the only thing
    // that changes after a request is sent.
    match /buddyRequests/{requestId} {
      allow read:   if signedIn() && (
        request.auth.uid == resource.data.fromUid ||
        request.auth.uid == resource.data.toUid
      );
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.fromUid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && requestId == request.resource.data.fromUid + '__' + request.resource.data.toUid
        && request.resource.data.status == 'pending';
      allow update: if signedIn()
        && (request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if signedIn() && (
        request.auth.uid == resource.data.fromUid ||
        request.auth.uid == resource.data.toUid
      );
    }

    // ---------- buddy relationships ----------
    // pairId is a deterministic "sorted_uid1_uid2". `users` is a 2-element array.
    // We split `get` (single-doc probe) from `list` (query) so that the
    // "are we already buddies?" probe against a NON-existent pair doesn't
    // crash on `resource.data.users` (resource is null for missing docs).
    // Instead we authorise the probe by reading the caller's uid out of
    // the deterministic pairId — only the two buddies can construct it
    // anyway, so no new information leaks.
    // A pair may only be written by the person who was ASKED, and only
    // against a pending request addressed to them by the other half — that
    // is the consent. Before 3.26.0 anyone signed in could make themselves
    // anybody's buddy (and so open a chat with them) with one write.
    function consentsToPair(reqId, other) {
      return reqId is string
        && exists(/databases/$(database)/documents/buddyRequests/$(reqId))
        && get(/databases/$(database)/documents/buddyRequests/$(reqId)).data.toUid == request.auth.uid
        && get(/databases/$(database)/documents/buddyRequests/$(reqId)).data.fromUid == other
        && get(/databases/$(database)/documents/buddyRequests/$(reqId)).data.status == 'pending';
    }
    match /buddies/{pairId} {
      allow get:    if signedIn() &&
        pairId.split('_').hasAny([request.auth.uid]);
      allow list:   if signedIn() && request.auth.uid in resource.data.users;
      allow create: if signedIn()
        && request.resource.data.users.size() == 2
        && request.auth.uid in request.resource.data.users
        && pairId == buddyPairId(request.resource.data.users[0], request.resource.data.users[1])
        && consentsToPair(
          request.resource.data.requestId,
          request.resource.data.users[0] == request.auth.uid ? request.resource.data.users[1] : request.resource.data.users[0]
        );
      allow update: if signedIn() && request.auth.uid in resource.data.users;
      allow delete: if signedIn() && request.auth.uid in resource.data.users;
    }

    // ---------- chats + messages ----------
    // A chat exists only for a buddy pair, and is written in the same batch
    // as the pair — hence existsAfter.
    match /chats/{chatId} {
      allow read:   if signedIn() && request.auth.uid in resource.data.users;
      allow create: if signedIn()
        && request.resource.data.users.size() == 2
        && request.auth.uid in request.resource.data.users
        && chatId == 'chat_' + buddyPairId(request.resource.data.users[0], request.resource.data.users[1])
        && existsAfter(/databases/$(database)/documents/buddies/$(buddyPairId(request.resource.data.users[0], request.resource.data.users[1])));
      allow update: if signedIn() && request.auth.uid in resource.data.users;

      match /messages/{messageId} {
        allow read:   if signedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users;
        allow create: if signedIn() && request.auth.uid == request.resource.data.senderId;
        // Allow ONLY the `reactions` field to change, and only by a chat
        // participant. The old rule was a blanket `if false` which
        // silently dropped every reaction toggle — local state flipped,
        // the listener then overwrote it with server state, and the
        // reaction vanished.
        allow update: if signedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.users &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions']);
        allow delete: if signedIn() && request.auth.uid == resource.data.senderId;
      }
    }

    // ---------- notifications ----------
    // Only the recipient can read. Any signed-in user can create (senders
    // include buddy requests, chat notifications, session invites, etc.).
    match /notifications/{uid}/items/{notifId} {
      allow read:   if signedIn() && request.auth.uid == uid;
      // The sender must be who they say they are, and must have a reason to
      // reach this person: they are buddies, or this is the request that
      // would make them buddies (checked against the request document), or
      // it is the self-test. Anyone else writing into a stream is spam
      // straight into the heads-up cards.
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.message is string && request.resource.data.message.size() <= 500
        && (
          uid == request.auth.uid
          || areBuddies(request.auth.uid, uid)
          || (request.resource.data.type == 'buddy_request'
            && exists(/databases/$(database)/documents/buddyRequests/$(request.auth.uid + '__' + uid)))
        );
      allow update: if signedIn() && request.auth.uid == uid;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // ---------- workoutSessions ----------
    // `participants` is a map keyed by uid. `in` on a map checks key membership.
    match /workoutSessions/{sessionId} {
      allow read:   if signedIn() && (
        request.auth.uid == resource.data.hostUid ||
        request.auth.uid in resource.data.participants
      );
      allow create: if signedIn() && request.auth.uid == request.resource.data.hostUid;
      allow update: if signedIn() && (
        request.auth.uid == resource.data.hostUid ||
        request.auth.uid in resource.data.participants
      );
      allow delete: if signedIn() && request.auth.uid == resource.data.hostUid;

      // Per-participant live progress snapshot. Only session participants
      // (host included) can read — previously any signed-in user could
      // spy on another session's live workout data.
      match /progress/{uid} {
        allow read:   if signedIn() && (
          request.auth.uid == uid ||
          request.auth.uid in get(/databases/$(database)/documents/workoutSessions/$(sessionId)).data.participants
        );
        allow write:  if signedIn() && request.auth.uid == uid;
      }

      // Ephemeral reaction stream — participants only.
      match /reactions/{reactionId} {
        allow read:   if signedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/workoutSessions/$(sessionId)).data.participants;
        allow create: if signedIn() &&
          request.auth.uid == request.resource.data.fromUid &&
          request.auth.uid in get(/databases/$(database)/documents/workoutSessions/$(sessionId)).data.participants;
      }
    }

    // ---------- shared exercise library (one doc per exercise) ----------
    // Anyone signed in can read and can create exercises they own. Only
    // the creator or an admin can change or remove a definition — this
    // is what makes "creator notes visible to everyone" trustworthy.
    match /sharedExercises/{exerciseId} {
      allow read:   if signedIn();
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if signedIn() && (resource.data.createdBy == request.auth.uid || isAdmin());
      allow delete: if signedIn() && (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    // ---------- shared food library (docs/HEALTH_SPEC.md) ----------
    // Same creator model as sharedExercises: anyone signed in can read,
    // creators own their docs, admins can moderate.
    match /sharedFoods/{foodId} {
      allow read:   if signedIn();
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if signedIn() && (resource.data.createdBy == request.auth.uid || isAdmin());
      allow delete: if signedIn() && (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    // ---------- shared meals (a set of foods logged together) ----------
    // Same creator model as sharedFoods.
    match /sharedMeals/{mealId} {
      allow read:   if signedIn();
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update: if signedIn() && (resource.data.createdBy == request.auth.uid || isAdmin());
      allow delete: if signedIn() && (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    // ---------- LEGACY shared exercise library ----------
    // The old single array document. Kept readable because older clients
    // still pull it and useOnlineStatus uses it as a connectivity probe;
    // no longer writable — any signed-in user could overwrite it wholesale.
    match /shared/{document} {
      allow read:   if signedIn();
    }

    // ---------- shared templates library ----------
    // Any authenticated user can browse + publish a template. The creator
    // may edit; anyone else may only bump useCount by exactly one.
    match /sharedTemplates/{templateId} {
      allow read:   if signedIn();
      allow create: if signedIn() && request.auth.uid == request.resource.data.creatorUid;
      allow update: if signedIn() && (
        request.auth.uid == resource.data.creatorUid ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['useCount'])
          && request.resource.data.useCount == resource.data.useCount + 1)
      );
      allow delete: if signedIn() && request.auth.uid == resource.data.creatorUid;
    }

    // ---------- Gym OS lite (Tier A) ----------
    // See docs/GYM_TIER_A_SPEC.md §3-4.
    // Join-code → gymId lookup. Created in the same batch as the gym (by its
    // owner); only that gym's owner or an admin can rotate/remove it.
    // ---------- gym invites (src/gymStaffHelpers.ts) ----------
    // Keyed by the invited email address, lower-cased, so the rule can check
    // the caller really is that person. Staff write them; the invitee reads
    // and deletes their own on the first sign-in that claims it.
    match /gymInvites/{email} {
      allow get:    if signedIn() && (
        (request.auth.token.email != null && request.auth.token.email.lower() == email)
        || isAdmin()
      );
      allow create: if signedIn() && (isAdmin() || isGymStaff(request.resource.data.gymId));
      allow update: if signedIn() && (isAdmin() || isGymStaff(resource.data.gymId));
      // The invitee clears their own invite once they have claimed it.
      allow delete: if signedIn() && (
        isAdmin()
        || isGymStaff(resource.data.gymId)
        || (request.auth.token.email != null && request.auth.token.email.lower() == email)
      );
    }

    // ---------- follows (src/followService.ts) ----------
    // One document per (follower, target) pair, id "<follower>__<target>".
    // Anyone signed in can see who follows whom; only the follower writes
    // their own edge, so nobody can put words in someone else's mouth.
    function buddyPairId(a, b) { return a < b ? a + '_' + b : b + '_' + a; }
    function areBuddies(a, b) {
      return exists(/databases/$(database)/documents/buddies/$(buddyPairId(a, b)));
    }

    match /follows/{edgeId} {
      allow read:   if signedIn();
      allow create: if signedIn()
        && edgeId == request.resource.data.follower + '__' + request.resource.data.target
        && request.resource.data.target != request.resource.data.follower
        && (
          // Your own edge, always.
          request.resource.data.follower == request.auth.uid
          // Or the reciprocal half of a buddy pair: the buddy document is
          // proof both people agreed, so either side may write both edges
          // rather than leaving one hanging until the other opens the app.
          || (request.resource.data.target == request.auth.uid
            && areBuddies(request.auth.uid, request.resource.data.follower))
        );
      allow update: if false;
      allow delete: if signedIn() && resource.data.follower == request.auth.uid;
    }

    match /gymJoinCodes/{code} {
      allow get:    if signedIn();
      // Only the owner of the gym the code points at (getAfter: the gym may
      // be created in the same batch) or an admin may mint a code.
      allow create: if signedIn() && request.resource.data.gymId is string && (
        isAdmin() ||
        getAfter(/databases/$(database)/documents/gyms/$(request.resource.data.gymId)).data.ownerUid == request.auth.uid
      );
      allow update, delete: if isGymOwner(resource.data.gymId) || isAdmin();
    }

    match /gyms/{gymId} {
      allow read: if isGymMember(gymId) || isGymStaff(gymId) || isAdmin();
      allow create: if signedIn() && ((request.resource.data.ownerUid == request.auth.uid && request.resource.data.staff[request.auth.uid] == 'owner') || isAdmin());
      allow update: if isGymOwner(gymId) || isAdmin()
                    || (isGymStaff(gymId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dailyCodeHash', 'dailyCodeDate']))
                    || (isGymManager(gymId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount', 'plans']))
                    // Joining (joinGymByCode): the member doc and the +1 land in one batch.
                    || (signedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount'])
                        && request.resource.data.memberCount == resource.data.get('memberCount', 0) + 1
                        && existsAfter(/databases/$(database)/documents/gyms/$(gymId)/members/$(request.auth.uid)));
      allow delete: if false;

      // Staff-only state that members must not be able to read: today's
      // check-in code hash lives here (private/dailyCode), not on the gym
      // doc every member can see — a 6-digit code behind a readable hash
      // is a one-second brute force.
      match /private/{docId} {
        allow read: if isGymStaff(gymId) || isAdmin();
        allow write: if (isGymStaff(gymId) || isAdmin()) && request.resource.data.keys().hasOnly(['hash', 'date', 'updatedAt']);
      }

      match /members/{uid} {
        allow read: if isGymStaff(gymId) || isAdmin() || request.auth.uid == uid
                    // The placeholder membership created against my e-mail, which I am claiming.
                    || (signedIn() && request.auth.token.email != null && myInvite().gymId == gymId && myInvite().memberUid == uid);
        // joining: a signed-in user creates their own member doc with role
        // 'member' — but only with a join code that really belongs to this
        // gym (the code is the invitation; without this check anyone who
        // knew a gym id could enrol themselves).
        allow create: if isGymManager(gymId) || isAdmin() || (
          signedIn() && request.auth.uid == uid && request.resource.data.role == 'member'
          && (
            // A join code the front desk gave them...
            (request.resource.data.joinCode is string
              && get(/databases/$(database)/documents/gymJoinCodes/$(request.resource.data.joinCode)).data.gymId == gymId)
            // ...or an invite the gym already created against their email,
            // which they are now signing in to claim (src/gymStaffHelpers.ts).
            || (request.auth.token.email != null
              && get(/databases/$(database)/documents/gymInvites/$(request.auth.token.email.lower())).data.gymId == gymId)
          )
        );
        allow update: if isGymManager(gymId) || isAdmin()
                      || (isGymStaff(gymId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastCheckinAt', 'checkinCount30d', 'checkinDates']))
                      || (request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastCheckinAt', 'checkinCount30d', 'checkinDates', 'lastWorkoutAt', 'photoURL', 'phone']));
        allow delete: if isGymManager(gymId) || isAdmin()
                      // Claiming an invite replaces the placeholder with the real account (src/gymStaffHelpers.ts).
                      || (signedIn() && request.auth.token.email != null && myInvite().gymId == gymId && myInvite().memberUid == uid);
      }
      match /payments/{id}   { allow read: if isGymStaff(gymId) || isAdmin() || request.auth.uid == resource.data.uid; allow create, update: if isGymManager(gymId) || isAdmin(); allow delete: if isGymOwner(gymId) || isAdmin(); }
      match /checkins/{id}   { allow read: if isGymStaff(gymId) || isAdmin() || request.auth.uid == resource.data.uid;
                               // Self check-in: the doc id must be `${uid}_${date}` and, for the
                               // daily code, the hash the client presents must match today's code
                               // on the gym doc (the code is otherwise only verified client-side).
                               allow create: if isGymStaff(gymId) || isAdmin() || (
                                 signedIn() && request.auth.uid == request.resource.data.uid
                                 && id == request.auth.uid + '_' + request.resource.data.date
                                 // No back-dating: the date must be today give or take a time zone.
                                 && nearToday(request.resource.data.date)
                                 && (
                                   // 'member-qr' is self-reported: the client checks the gym's
                                   // geofence (src/geo.ts) and writes the distance, but rules
                                   // cannot verify a location. The daily code below is the
                                   // verified path — staff rotate it and rules check the hash
                                   // against the staff-only private/dailyCode doc.
                                   request.resource.data.method == 'member-qr' ||
                                   (request.resource.data.method == 'code'
                                     && request.resource.data.codeHash == get(/databases/$(database)/documents/gyms/$(gymId)/private/dailyCode).data.hash
                                     && request.resource.data.date == get(/databases/$(database)/documents/gyms/$(gymId)/private/dailyCode).data.date)
                                 )
                               );
                               allow update, delete: if isGymManager(gymId) || isAdmin(); }
      match /dailyStats/{date} { allow read: if isGymStaff(gymId) || isAdmin();
                               // Members may only bump the counter by one, and only for a day they
                               // really checked in on — the check-in doc `${uid}_${date}` is written
                               // first (checkinMember in gymService.ts), so its existence is the proof.
                               allow create: if isGymStaff(gymId) || isAdmin() || (isGymMember(gymId)
                                 && request.resource.data.keys().hasOnly(['date', 'count', 'hours'])
                                 && request.resource.data.date == date && request.resource.data.count == 1
                                 && exists(/databases/$(database)/documents/gyms/$(gymId)/checkins/$(request.auth.uid + '_' + date)));
                               allow update: if isGymStaff(gymId) || isAdmin() || (isGymMember(gymId)
                                 && request.resource.data.keys().hasOnly(['date', 'count', 'hours'])
                                 && request.resource.data.date == date && request.resource.data.count == resource.data.count + 1
                                 && exists(/databases/$(database)/documents/gyms/$(gymId)/checkins/$(request.auth.uid + '_' + date))); }
      // Machines on the floor (GymOpsView's asset health). Any staff can
      // see what is out of service; only a manager flips it.
      match /equipment/{id} { allow read: if isGymStaff(gymId) || isAdmin();
                              allow write: if isGymManager(gymId) || isAdmin(); }
      match /classes/{id}    { allow read: if isGymMember(gymId) || isGymStaff(gymId) || isAdmin(); allow write: if isGymManager(gymId) || isAdmin();
        match /sessions/{date} { allow read: if isGymMember(gymId) || isGymStaff(gymId) || isAdmin();
                                 // Staff/admin: anything. Member: may CREATE the session doc as the first
                                 // enrollee (only themselves enrolled, nobody attended) and may UPDATE only
                                 // the enrolled array (enrol / unenrol).
                                 allow create: if isGymStaff(gymId) || isAdmin()
                                   || (isGymMember(gymId) && request.resource.data.enrolled.hasOnly([request.auth.uid]) && request.resource.data.attended.size() == 0);
                                 allow update: if isGymStaff(gymId) || isAdmin()
                                   || (isGymMember(gymId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enrolled'])
                                       // ...and the only name that may appear or disappear is their own.
                                       && request.resource.data.enrolled.toSet().difference(resource.data.enrolled.toSet()).hasOnly([request.auth.uid])
                                       && resource.data.enrolled.toSet().difference(request.resource.data.enrolled.toSet()).hasOnly([request.auth.uid]));
                                 allow delete: if false; } }
      // ---------- the gym's own content (src/gymLibrary.ts) ----------
      // Exercises with the trainers' videos, and the plans they publish.
      // Staff write; every member reads. A member adopting a plan may bump
      // its useCount by one and nothing else.
      match /exercises/{id} {
        allow read: if isGymMember(gymId) || isGymStaff(gymId) || isAdmin();
        allow write: if isGymStaff(gymId) || isAdmin();
      }
      match /plans/{id} {
        allow read: if isGymMember(gymId) || isGymStaff(gymId) || isAdmin();
        allow create, delete: if isGymStaff(gymId) || isAdmin();
        allow update: if isGymStaff(gymId) || isAdmin()
          || (isGymMember(gymId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['useCount'])
              && request.resource.data.useCount == resource.data.get('useCount', 0) + 1);
      }
      // Anonymous session ratings, written only by api/rate.ts (firebase-admin).
      // Managers read them for Analytics; trainers do not see them here.
      match /ratings/{id} {
        allow read: if isGymManager(gymId) || isAdmin();
        allow write: if false;
      }

      match /announcements/{id} {
        allow read: if isGymMember(gymId) || isGymStaff(gymId) || isAdmin();
        allow create: if isGymStaff(gymId) || isAdmin();
        // The author, a manager or an admin — a trainer cannot take down a colleague's notice.
        allow update, delete: if isGymManager(gymId) || isAdmin() || (isGymStaff(gymId) && resource.data.byUid == request.auth.uid);

        // A poster or a photo of the notice board, kept out of the list query.
        match /media/{mediaId} {
          allow read: if isGymMember(gymId) || isGymStaff(gymId) || isAdmin();
          allow create: if (isGymStaff(gymId) || isAdmin()) && request.resource.data.uid == request.auth.uid;
          allow update: if false;
          allow delete: if isGymManager(gymId) || isAdmin() || (isGymStaff(gymId) && resource.data.uid == request.auth.uid);
        }
      }

      // ---------- gym feed (src/gymFeed.ts) ----------
      // Only this gym's people can read it. A member posts as themselves,
      // deletes their own, and may otherwise touch nothing but their own
      // key in the reactions map — so a fist-bump can never rewrite the
      // post it is attached to. Staff can remove anything.
      match /feed/{postId} {
        allow read: if isGymMember(gymId) || isGymStaff(gymId) || isAdmin();
        allow create: if (isGymMember(gymId) || isGymStaff(gymId))
          && request.resource.data.uid == request.auth.uid
          && postId.matches(request.auth.uid + '_.*');
        // Anyone in the gym may react (their own key only) and may bump the
        // denormalised comment count by one either way — nothing else.
        allow update: if isGymStaff(gymId) || isAdmin()
          || (resource.data.uid == request.auth.uid && request.resource.data.uid == request.auth.uid)
          || ((isGymMember(gymId) || isGymStaff(gymId))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
            && request.resource.data.reactions.diff(resource.data.reactions).affectedKeys().hasOnly([request.auth.uid]))
          || ((isGymMember(gymId) || isGymStaff(gymId))
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount'])
            && (request.resource.data.commentCount == resource.data.get('commentCount', 0) + 1
              || request.resource.data.commentCount == resource.data.get('commentCount', 0) - 1));
        allow delete: if isGymStaff(gymId) || isAdmin() || resource.data.uid == request.auth.uid;

        // One comment per doc. A member writes as themselves and deletes
        // their own; staff can remove anything.
        match /comments/{commentId} {
          allow read: if isGymMember(gymId) || isGymStaff(gymId) || isAdmin();
          allow create: if (isGymMember(gymId) || isGymStaff(gymId))
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 500;
          allow update: if false;
          allow delete: if isGymStaff(gymId) || isAdmin() || resource.data.uid == request.auth.uid;
        }

        // The post's photo, kept out of the list query so opening the feed
        // does not download every image in it.
        match /media/{mediaId} {
          allow read: if isGymMember(gymId) || isGymStaff(gymId) || isAdmin();
          allow create: if (isGymMember(gymId) || isGymStaff(gymId)) && request.resource.data.uid == request.auth.uid;
          allow update: if false;
          allow delete: if isGymStaff(gymId) || isAdmin() || resource.data.uid == request.auth.uid;
        }
      }
    }
  }
}
